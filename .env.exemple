# Canal MCP RankFabrik — configuration
#
# Copier en .env pour un test local, ou renseigner ces variables dans la
# configuration du client MCP (Claude Desktop, Cursor, Smithery…).

# Clé fédérée d'accès aux 4 API RankFabrik (obligatoire). Format rf_…
# Clé d'essai gratuite (500 unités/mois, sans carte) sur rankfabrik.com/tarifs.
# Ne jamais committer une vraie clé.
RANKFABRIK_API_KEY=

# URL affichée dans les messages d'onboarding (facultatif).
# Défaut : https://rankfabrik.com/tarifs
# RANKFABRIK_URL_CLE=https://rankfabrik.com/tarifs

# En-tête portant la clé (facultatif). Défaut : x-cle-api
# RANKFABRIK_EN_TETE_CLE=x-cle-api

# Surcharges avancées, produit par produit (facultatif). Chaque produit vise son
# sous-domaine par défaut ; on peut surcharger cible et/ou clé individuellement.
# RANKFABRIK_CAPTIONS_URL=https://captions.rankfabrik.com
# RANKFABRIK_PLACES_URL=https://places.rankfabrik.com
# RANKFABRIK_JOBS_URL=https://jobs.rankfabrik.com
# RANKFABRIK_VERIFY_URL=https://verify.rankfabrik.com
# RANKFABRIK_CAPTIONS_KEY=
# RANKFABRIK_PLACES_KEY=
# RANKFABRIK_JOBS_KEY=
# RANKFABRIK_VERIFY_KEY=
# RANKFABRIK_BASE_URL=  # alias historique de la cible Captions

# Transport (facultatif). stdio (défaut) pour clients locaux et directories ;
# http pour l'hébergement distant (Streamable HTTP sur /mcp).
# MCP_TRANSPORT=stdio
# PORT=8090
